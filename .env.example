# ---- Shared ----
# Use DATABASE_URL for Postgres/MySQL in production.
# Examples:
#   postgresql://user:password@host:5432/berkeley
#   mysql://user:password@host:3306/berkeley
DATABASE_URL=
DB_PATH=knowledge_engine.db
DB_CONNECT_TIMEOUT=5
DB_MAX_RETRIES=2
DB_RETRY_BACKOFF_SEC=0.3
LOG_LEVEL=INFO

# ---- Engine ----
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
ENGINE_ENV=dev
ENGINE_RUN_JOBS_INLINE=true
ENGINE_SLICE_LIMIT=40
ENGINE_SLICE_MINUTES=60
ENGINE_ALLOW_UNMAPPED_CHANNELS=false
ENGINE_TRUST_GUILD_ID=

# ---- Auth ----
BOT_INGEST_TOKEN=dev-bot-token
CLIENT_ID=discord_bot
CLIENT_TOKEN=dev-client-token
ADMIN_TOKEN=dev-admin-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
CONTEXT_TOKEN_SECRET=change-me
CONTEXT_TOKEN_TTL_SEC=3600

# ---- Discord Bot ----
BOT_TOKEN=your_discord_bot_token
GUILD_ID=1234567890
STUDENT_ROLE_NAME=student
BERKELEY_SUFFIX=@berkeley.edu
PRIVATE_CONTAINERS=true
ENGINE_BASE_URL=http://127.0.0.1:8000
COURSE_CATEGORY_ID=
DEFAULT_PROFESSOR_NAME=
DEFAULT_TERM=fa25
ENGINE_HTTP_TIMEOUT=10
ENGINE_HTTP_MAX_RETRIES=3
ENGINE_HTTP_RETRY_BACKOFF_SEC=0.5

# Bot storage (set BOT_STORAGE_BACKEND=db to use DB, json for local files)
BOT_STORAGE_BACKEND=db
BOT_DATABASE_URL=
BOT_DB_CONNECT_TIMEOUT=5
BOT_DB_MAX_RETRIES=2
BOT_DB_RETRY_BACKOFF_SEC=0.3

# ---- Memory ----
# MEMORY_BACKEND=filesystem or disabled
MEMORY_BACKEND=filesystem
MEMORY_ROOT=memory
MEMORY_DATA_ROOT=memory/data
MEMORY_CHUNK_SIZE=20
MEMORY_CHUNK_OVERLAP=5
MEMORY_EMBED_DIM=128
MEMORY_VECTOR_WEIGHT=0.7
MEMORY_TEXT_WEIGHT=0.3
MEMORY_ENABLE_BM25=true
MEMORY_ENABLE_EMBEDDINGS=true
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_LLM_API_KEY=
